#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Catppuccin Mocha color scheme + AeroSpace workspace integration

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# ── Bar appearance ────────────────────────────────────────────────────────────
sketchybar --bar \
    position=top          \
    height=34             \
    margin=4              \
    y_offset=0            \
    corner_radius=10      \
    blur_radius=0        \
    color="$CATPPUCCIN_BAR_COLOR" \
    border_width=1        \
    border_color="$CATPPUCCIN_BORDER_COLOR" \
    shadow=on             \
    topmost=window        \
    padding_left=12       \
    padding_right=12

# ── Global item defaults ──────────────────────────────────────────────────────
sketchybar --default \
    padding_left=4                              \
    padding_right=4                             \
    icon.font="HackNerdFont-Bold:Bold:15.0"     \
    label.font="HackNerdFont-Bold:Bold:13.0"    \
    icon.color="$CATPPUCCIN_TEXT"              \
    label.color="$CATPPUCCIN_TEXT"             \
    icon.padding_left=6                         \
    icon.padding_right=4                        \
    label.padding_left=4                        \
    label.padding_right=6

# ── LEFT: AeroSpace workspace indicators ──────────────────────────────────────
sketchybar --add event aerospace_workspace_change

COLOR="$CATPPUCCIN_MAUVE"
for sid in $(seq 1 5); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
            background.color=0x00000000              \
            background.corner_radius=6               \
            background.height=24                     \
            background.drawing=off                   \
            label="$sid"                             \
            label.font="HackNerdFont-Bold:Bold:12.0" \
            label.color=$COLOR                       \
            icon.drawing=off                         \
            padding_left=3                           \
            padding_right=3                          \
            click_script="aerospace workspace $sid"  \
            script="$PLUGIN_DIR/aerospace.sh $sid $COLOR"
done

# Group workspace items under a shared background pill
sketchybar --add bracket workspaces '/space\..*/' \
    --set workspaces \
        background.color="$CATPPUCCIN_BRACKET_COLOR" \
        background.corner_radius=8      \
        background.height=28            \
        background.border_width=1       \
        background.border_color="$CATPPUCCIN_SUBTLE_BORDER_COLOR"

# ── LEFT: Frontmost app name ──────────────────────────────────────────────────
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off                                    \
        label.font="HackNerdFont-Bold:Bold:13.0"            \
        label.color="$CATPPUCCIN_SUBTEXT0"                  \
        padding_left=10                                     \
        script="$PLUGIN_DIR/front_app.sh"                   \
    --subscribe front_app front_app_switched

# ── RIGHT: Clock ──────────────────────────────────────────────────────────────
sketchybar --add item clock right \
    --set clock \
        icon=""                     \
        icon.color="$CATPPUCCIN_BLUE" \
        icon.padding_left=0           \
        label.color="$CATPPUCCIN_TEXT" \
        padding_left=4              \
        padding_right=4             \
        update_freq=10              \
        script="$PLUGIN_DIR/clock.sh"

# ── RIGHT: Battery ────────────────────────────────────────────────────────────
sketchybar --add item battery right \
    --set battery \
        label.color="$CATPPUCCIN_TEXT" \
        update_freq=120             \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

# ── RIGHT: Volume ─────────────────────────────────────────────────────────────
sketchybar --add item volume right \
    --set volume \
        label.color="$CATPPUCCIN_TEXT" \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

# ── RIGHT: CPU ───────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
    --set cpu \
        icon="󰻠"                   \
        icon.font="HackNerdFont-Bold:Bold:15.0" \
        icon.color="$CATPPUCCIN_GREEN" \
        label.color="$CATPPUCCIN_TEXT"  \
        update_freq=10              \
        script="$PLUGIN_DIR/cpu.sh"

# ── RIGHT: Memory ─────────────────────────────────────────────────────────────
sketchybar --add item memory right \
    --set memory \
        label.color="$CATPPUCCIN_TEXT" \
        update_freq=10              \
        script="$PLUGIN_DIR/memory.sh"

# ── Trigger initial update ────────────────────────────────────────────────────
sketchybar --update
