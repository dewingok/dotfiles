Host github.com
  Hostname github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host github-work
  Hostname github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes

Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 4
  VerifyHostKeyDNS ask
  ControlMaster auto
  ControlPath ~/.ssh/control:%n:%p:%r
